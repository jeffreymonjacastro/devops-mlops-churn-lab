rent="1"><mxGeometry x="420" y="150" width="320" height="46" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Secrets&lt;/b&gt;&lt;br&gt;AWS_ACCESS_KEY_ID…" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#52514e;fontColor=#0b0b0b;fontSize=11;fontStyle=0;absoluteArcSize=1;arcSize=12;dashed=0;" vertex="1" parent="1"><mxGeometry x="420" y="226" width="155" height="46" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Variable&lt;/b&gt;&lt;br&gt;AWS_DEPLOY = true" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a78d6;strokeColor=#2a78d6;fontColor=#ffffff;fontSize=11;fontStyle=0;absoluteArcSize=1;arcSize=12;dashed=0;" vertex="1" parent="1"><mxGeometry x="585" y="226" width="155" height="46" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;mlops.yml · 7 jobs&lt;/b&gt;&lt;br&gt;test → data-validation → data-prep → train&lt;br&gt;→ evaluate → smoke-test → build-and-publish" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#52514e;fontColor=#0b0b0b;fontSize=11;fontStyle=0;absoluteArcSize=1;arcSize=12;dashed=0;" vertex="1" parent="1"><mxGeometry x="420" y="302" width="320" height="58" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;deploy-staging&lt;/b&gt;&lt;br&gt;solo develop&lt;br&gt;+ test de skew" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a78d6;strokeColor=#2a78d6;fontColor=#ffffff;fontSize=11;fontStyle=0;absoluteArcSize=1;arcSize=12;dashed=0;" vertex="1" parent="1"><mxGeometry x="420" y="390" width="155" height="58" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;deploy-production&lt;/b&gt;&lt;br&gt;solo main&lt;br&gt;con aprobación" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a78d6;strokeColor=#2a78d6;fontColor=#ffffff;fontSize=11;fontStyle=0;absoluteArcSize=1;arcSize=12;dashed=0;" vertex="1" parent="1"><mxGeometry x="585" y="390" width="155" height="58" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;model-monitoring.yml&lt;/b&gt;&lt;br&gt;cada lunes · monitor.py --fail-on-retrain" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c3c2b7;fontColor=#c3c2b7;fontSize=11;fontStyle=0;absoluteArcSize=1;arcSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="420" y="478" width="320" height="46" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Amazon ECR&lt;/b&gt;&lt;br&gt;repositorio churn-predictor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#52514e;fontColor=#0b0b0b;fontSize=11;fontStyle=0;absoluteArcSize=1;arcSize=12;dashed=0;" vertex="1" parent="1"><mxGeometry x="800" y="150" width="320" height="46" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Staging&lt;/b&gt;&lt;br&gt;load balancer → ECS Fargate&lt;br&gt;churn-predictor-staging" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#52514e;fontColor=#0b0b0b;fontSize=11;fontStyle=0;absoluteArcSize=1;arcSize=12;dashed=0;" vertex="1" parent="1"><mxGeometry x="800" y="302" width="320" height="58" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Producción&lt;/b&gt;&lt;br&gt;load balancer → ECS Fargate&lt;br&gt;churn-predictor-prod" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#52514e;fontColor=#0b0b0b;fontSize=11;fontStyle=0;absoluteArcSize=1;arcSize=12;dashed=0;" vertex="1" parent="1"><mxGeometry x="800" y="390" width="320" height="58" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;1.&lt;/b&gt; Creas la variable de repositorio AWS_DEPLOY = true. Es el interruptor: le dice al pipeline que ya hay entornos." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#0b0b0b;" vertex="1" parent="1"><mxGeometry x="20" y="558" width="1120" height="22" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;2.&lt;/b&gt; En Settings → Environments, production recibe Required reviewers y solo la rama main." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;ali