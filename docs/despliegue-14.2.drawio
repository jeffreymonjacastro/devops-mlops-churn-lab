mxCell id="c35" value="&lt;b&gt;2.&lt;/b&gt; Lo mismo con envs/prod.tfvars en el workspace prod. Mismo código, otro archivo de variables y otro estado." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#0b0b0b;" vertex="1" parent="1"><mxGeometry x="20" y="582" width="1120" height="22" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;3.&lt;/b&gt; ECS descarga de ECR la imagen del paso anterior y arranca la API. Por eso la imagen va antes que el entorno." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#0b0b0b;" vertex="1" parent="1"><mxGeometry x="20" y="606" width="1120" height="22" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;4.&lt;/b&gt; Desde tu máquina compruebas con curl que /health responde en la URL del load balancer." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#0b0b0b;" vertex="1" parent="1"><mxGeometry x="20" y="630" width="1120" height="22" as="geometry"/></mxCell><mxCell id="c38" value="Participa en este paso" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a78d6;strokeColor=#2a78d6;fontColor=#ffffff;fontSize=10;fontStyle=0;absoluteArcSize=1;arcSize=12;dashed=0;" vertex="1" parent="1"><mxGeometry x="20" y="660" width="180" height="24" as="geometry"/></mxCell><mxCell id="c39" value="Ya existe" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#52514e;fontColor=#0b0b0b;fontSize=10;fontStyle=0;absoluteArcSize=1;arcSize=12;dashed=0;" vertex="1" parent="1"><mxGeometry x="210" y="660" width="180" height="24" as="geometry"/></mxCell><mxCell id="c40" value="El pipeline lo omite" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e4e3df;strokeColor=#c3c2b7;fontColor=#52514e;fontSize=10;fontStyle=0;absoluteArcSize=1;arcSize=12;dashed=0;" vertex="1" parent="1"><mxGeome